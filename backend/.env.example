SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Gmail SMTP: SMTP_PASSWORD is a Gmail App Password, not your normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-address@gmail.com

# Optional: timezone for times shown in reminder emails (default Asia/Kolkata)
DISPLAY_TIMEZONE=Asia/Kolkata

# Optional: frontend address used by the "Open TaskMaster" button in emails
FRONTEND_URL=https://fastapi-task-manager-khaki.vercel.app

# Optional: comma-separated frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://fastapi-task-manager-khaki.vercel.app